# Copie para .env.local e preencha. Nenhuma variável é obrigatória para o build.

# Endereço público do site, sem barra no fim (canonical, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# Chave do formulário de contato (https://web3forms.com, grátis). Sem ela o formulário
# mostra o telefone como alternativa.
NEXT_PUBLIC_WEB3FORMS_KEY=

# WhatsApp com DDI e DDD, só números (ex.: 5527999990000). Sem ele o botão flutuante não aparece.
NEXT_PUBLIC_WHATSAPP=

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Sem ele nenhum script de medição é carregado.
NEXT_PUBLIC_GA_ID=

# Usado só pelos scripts de imagem (npm run fotos / npm run media): pasta original da PCR.
PCR_SOURCE="C:/caminho/para/a/pasta/PCR"
